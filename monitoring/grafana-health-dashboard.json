{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "Forja API · Saúde do Sistema",
  "uid": "forja-api-health",
  "tags": ["forja", "ue-33"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Instâncias UP",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "up{job=\"forja-api\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ],
          "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Requisições/s",
      "type": "timeseries",
      "gridPos": { "x": 4, "y": 0, "w": 10, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"forja-api\"}[5m]))",
          "legendFormat": "total",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"forja-api\", status=~\"5..\"}[5m]))",
          "legendFormat": "5xx",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Taxa de erro 5xx (%)",
      "type": "gauge",
      "gridPos": { "x": 14, "y": 0, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"forja-api\", status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"forja-api\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 2 }, { "color": "red", "value": 5 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Latência p95 (s)",
      "type": "gauge",
      "gridPos": { "x": 19, "y": 0, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"forja-api\"}[5m])) by (le))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 1.5 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Pool de conexões do banco (Hikari)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"forja-api\"}",
          "legendFormat": "ativas",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"forja-api\"}",
          "legendFormat": "ociosas",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_max{application=\"forja-api\"}",
          "legendFormat": "máximo",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "title": "JVM · heap usado vs máximo",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"forja-api\", area=\"heap\"}",
          "legendFormat": "usado",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{application=\"forja-api\", area=\"heap\"}",
          "legendFormat": "máximo",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      }
    }
  ]
}
