# FORJA — variáveis de ambiente

# Frontend (Vite) — URL base da API
VITE_API_URL=http://localhost:8085/api

# Backend (Spring Boot) — opcionais, têm defaults em application.yml
DB_HOST=localhost
DB_PORT=5433
DB_NAME=forja
DB_USER=forja
DB_PASS=forja
# Segredo JWT (32+ caracteres em produção)
JWT_SECRET=forja-dev-secret-troque-em-producao

# Observabilidade (UE-25)
# Perfil Spring: dev (logs legíveis) | prod (logs JSON estruturados)
SPRING_PROFILES_ACTIVE=dev
# Ajuste fino de níveis de log (binding relaxado do Spring)
# LOGGING_LEVEL_COM_FORJA=INFO

# Segurança HTTP e rate limiting (UE-26) — defaults em application.yml
# Origens CORS permitidas, separadas por vírgula (scheme exato, sem barra final)
# FORJA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Limites de taxa (janela deslizante) — ver docs/security/rate-limiting.md
# FORJA_RATELIMIT_LOGIN_LIMIT=5
# FORJA_RATELIMIT_REGISTER_LIMIT=5
# FORJA_RATELIMIT_PUBLICREAD_LIMIT=30
# FORJA_RATELIMIT_AUTHENTICATED_LIMIT=100
# Limite de payload por requisição (bytes; 413 acima disso)
# FORJA_RATELIMIT_MAXPAYLOADBYTES=1048576
# HSTS: habilitar SOMENTE em produção atrás de HTTPS
# FORJA_SECURITY_HSTS_ENABLED=false
