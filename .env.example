# FORJA — variáveis de ambiente (Fase 1)

# Supabase (projeto em supabase.com)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key   # apenas em rotinas server (seed, cron)

# Prisma → Postgres do Supabase
# Pooled (app): usa o pooler de sessão
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
# Direta (migrations/seed): conexão direta
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres"

# Next.js Auth
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
