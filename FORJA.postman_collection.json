{
  "info": {
    "name": "FORJA - Ultra Exercises API",
    "description": "Coleção QA para API FORJA. Base: http://localhost:8085 | Swagger: http://localhost:8085/swagger-ui/index.html | Contrato de erro: docs/api/error-response-contract.md | Endpoints: docs/api/openapi.md | Variáveis: {{baseUrl}} (ex: http://localhost:8085), {{token}} (Bearer JWT)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Health & Docs",
      "item": [
        {
          "name": "GET Swagger JSON (v3/api-docs)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v3/api-docs",
              "host": ["{{baseUrl}}"],
              "path": ["v3", "api-docs"]
            },
            "description": "Baixa OpenAPI JSON gerado pelo springdoc. Útil para validar contrato sem backend."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"É JSON OpenAPI\", () => { const j = pm.response.json(); pm.expect(j).to.have.property('openapi'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Swagger UI (html)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/swagger-ui/index.html",
              "host": ["{{baseUrl}}"],
              "path": ["swagger-ui", "index.html"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test(\"Swagger UI 200\", () => pm.expect(pm.response.code).to.be.oneOf([200, 304]));"],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "POST /api/auth/register - criar usuário",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Trace-Id", "value": "{{traceId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"qa-{{$timestamp}}@test.example.com\",\n  \"password\": \"Test@123456\",\n  \"name\": \"QA Test User\"\n}"
            },
            "description": "201 com {token,email,name}. Email duplicado hoje retorna 409 corpo vazio (contrato futuro). Teste também 400 VALIDATION_ERROR sem senha."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Register 201\", () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "if(pm.response.code===201 || pm.response.code===200){ const j=pm.response.json(); pm.expect(j).to.have.property('token'); pm.environment.set('token', j.token); pm.environment.set('lastEmail', j.email || JSON.parse(pm.request.body.raw).email); console.log('token salvo:', j.token.slice(0,20)+'...'); }",
                  "pm.test(\"traceId header ecoa\", () => { const hdr = pm.response.headers.get('X-Trace-Id'); if(hdr) pm.expect(hdr.length).to.be.above(7); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/register - 409 duplicado",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{lastEmail}}\",\n  \"password\": \"Test@123456\",\n  \"name\": \"Dup User\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"409 ou 400 duplicado\", () => pm.expect(pm.response.code).to.be.oneOf([409,400,422]));",
                  "// Hoje corpo vazio em 409 é esperado (docs/api/error-response-contract.md)"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login - sucesso",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Trace-Id", "value": "{{traceId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Tem token e user\", () => { pm.expect(j).to.have.property('token'); pm.expect(j.token.length).to.be.above(10); });",
                  "pm.environment.set('token', j.token);",
                  "pm.test(\"traceId presente\", () => { if(j.traceId) pm.expect(j.traceId.length).to.be.above(7); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login - 401 credenciais inválidas (contrato)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Trace-Id", "value": "e2e-{{$timestamp}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invalid@test.com\",\n  \"password\": \"wrongpassword\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"401 UNAUTHORIZED\", () => pm.response.to.have.status(401));",
                  "const b = pm.response.json();",
                  "pm.test(\"Contrato de erro UE-25\", () => { pm.expect(b).to.have.property('timestamp'); pm.expect(b).to.have.property('status', 401); pm.expect(b).to.have.property('error'); pm.expect(b.error).to.match(/UNAUTHORIZED|INVALID|AUTH/i); pm.expect(b).to.have.property('message'); pm.expect(b).to.have.property('traceId'); pm.expect(b.traceId.length).to.be.above(7); });",
                  "pm.test(\"Header X-Trace-Id == body traceId\", () => { const h = pm.response.headers.get('X-Trace-Id') || pm.response.headers.get('x-trace-id'); if(h) pm.expect(h).to.eql(b.traceId); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login - 400 sem email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"password\": \"Test@123456\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test(\"400 ou 422 validação\", () => pm.expect(pm.response.code).to.be.oneOf([400,422]));"],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me - com token",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 me\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json(); pm.test(\"tem email e name\", () => { pm.expect(b).to.have.property('email'); pm.expect(b).to.have.property('name'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me - sem token 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"401 sem token\", () => pm.response.to.have.status(401));",
                  "const b = pm.response.json(); pm.test(\"contrato 401\", () => pm.expect(b).to.have.property('traceId'));",
                  "pm.test(\"security nosniff\", () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/refresh - refresh token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test(\"200 ou 401\", () => pm.expect(pm.response.code).to.be.oneOf([200,401]));"],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
