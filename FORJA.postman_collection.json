            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/progress/readiness-trend?days=30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "progress", "readiness-trend"],
              "query": [{ "key": "days", "value": "30" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test(\"200 trend\", () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "09 - CORS & Security",
      "item": [
        {
          "name": "OPTIONS /api/auth/login (CORS)",
          "request": {
            "method": "OPTIONS",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test(\"CORS 200/204\", () => pm.expect(pm.response.code).to.be.oneOf([200,204]));", "pm.test(\"CORS header\", () => pm.expect(pm.response.headers.has('access-control-allow-origin') || pm.response.headers.has('access-control-allow-methods')).to.be.true; );"],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
